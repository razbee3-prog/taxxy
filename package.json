{
  "name": "taxxy",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @taxxy/agent dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:tier1": "pnpm --filter @taxxy/engine test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
