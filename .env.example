# Agent
PORT=8787
LLM_API_KEY=                 # Anthropic key for the orchestrator (ANTHROPIC_API_KEY also accepted)
ORCHESTRATOR_MODEL=claude-sonnet-5-5
CATEGORIZER_MODEL=claude-haiku-5-5
CATEGORIZER_THRESHOLD=0.80
TAXXY_ENV=dev

# Langfuse Cloud
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# SurrealDB
SURREAL_URL=ws://surrealdb:8000/rpc
SURREAL_NS=taxxy
SURREAL_DB=taxxy
SURREAL_USER=root
SURREAL_PASS=root

# Plaid (M3). PLAID_MODE=fixture serves the sandbox fixture offline; live uses the credentials below.
PLAID_MODE=fixture
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_WEBHOOK_URL=
PLAID_WEBHOOK_VERIFY=false

# Gmail (M5). GMAIL_MODE=fixture serves the offline mailbox; live uses our Google OAuth client
# (GOOGLE_* below); merge delegates per-user Gmail auth to Merge Agent Handler (MERGE_* below) and
# Taxxy never stores Google tokens.
GMAIL_MODE=fixture
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/gmail/callback
MERGE_AGENT_HANDLER_TOKEN=
MERGE_TOOL_PACK_ID=
MERGE_API_BASE=https://ah-api.merge.dev

# Vault + storage (M2 / hosting)
VAULT_KEY=
SPACES_KEY=
SPACES_SECRET=
SPACES_BUCKET=
SPACES_REGION=

# Web app
WEB_PORT=3000
AGENT_URL=http://127.0.0.1:8787
# openssl rand -hex 32
SESSION_SECRET=
